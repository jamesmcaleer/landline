{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesmcaleer/landline/extension/session.schema.json",
  "title": "Landline session export",
  "description": "A captured logged-in session, produced by the extension and consumed by the session service. See SESSION_FORMAT.md.",
  "type": "object",
  "required": ["formatVersion", "capturedAt", "site", "browser", "cookies", "origins"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "site": {
      "type": "object",
      "required": ["url", "title", "domain"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "domain": { "type": "string" }
      }
    },
    "browser": {
      "type": "object",
      "required": ["userAgent", "platform", "language", "timezone", "screen"],
      "additionalProperties": false,
      "properties": {
        "userAgent": { "type": "string" },
        "platform": { "type": "string" },
        "language": { "type": "string" },
        "timezone": { "type": "string", "description": "IANA timezone name" },
        "screen": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        }
      }
    },
    "cookies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "domain", "path", "secure", "httpOnly", "sameSite", "hostOnly", "session"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "domain": { "type": "string" },
          "path": { "type": "string" },
          "secure": { "type": "boolean" },
          "httpOnly": { "type": "boolean" },
          "sameSite": { "enum": ["Strict", "Lax", "None"] },
          "hostOnly": { "type": "boolean" },
          "session": { "type": "boolean" },
          "expirationDate": {
            "type": "number",
            "description": "Unix seconds. Present only when session is false."
          }
        }
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "localStorage", "sessionStorage", "indexedDB"],
        "additionalProperties": false,
        "properties": {
          "origin": { "type": "string", "format": "uri" },
          "localStorage": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "sessionStorage": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "indexedDB": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "version", "stores"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "version": { "type": "integer" },
                "stores": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "keyPath", "autoIncrement", "records"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "keyPath": {
                        "description": "Inline key path: a string, an array of strings, or null for out-of-line keys.",
                        "anyOf": [
                          { "type": "string" },
                          { "type": "array", "items": { "type": "string" } },
                          { "type": "null" }
                        ]
                      },
                      "autoIncrement": { "type": "boolean" },
                      "records": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["key", "value"],
                          "additionalProperties": false,
                          "properties": {
                            "key": {
                              "description": "The record's key. Used on replay only for out-of-line stores (keyPath null)."
                            },
                            "value": {
                              "description": "The stored value. Structured-clone data reduced to JSON; binary values are not preserved."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
