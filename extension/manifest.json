{
  "manifest_version": 3,
  "name": "Landline",
  "description": "Connect a logged-in site so you can text or call it.",
  "version": "0.0.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Landline",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
