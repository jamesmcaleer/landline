{
  "manifest_version": 3,
  "name": "Landline",
  "description": "Connect a logged-in site so you can text or call it.",
  "version": "0.0.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Landline"
  },
  "permissions": ["cookies", "scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
