PORT=3000
LANDLINE_PHONE=+15555555555         # the number users call, shown by GET /config
PUBLIC_URL=http://localhost:3000     # must be HTTPS and a real host for Face ID; ngrok is fine
CALLBACK_URL=                        # optional: backend POSTs {connectionId,type,text,url?} here
FACTORY_API_KEY=                     # Factory key for the Droid SDK
DROID_EXEC_PATH=                     # optional: path to the droid binary (default: droid on PATH)
BROWSER_PROVIDER=local              # local | chalk (chalk: PUBLIC_URL must be the public https host, e.g. cloudflared)
PHOTON_PROJECT_ID=                   # Photon project that owns the shared iMessage line
PHOTON_API_KEY=                      # Photon project API key (pho_sk_...)
VERIFIER_PHONE=                      # optional: approval links are texted here (often a caretaker, not the caller)
MCP_TOKEN=                          # bearer token the voice agent platform must send to /mcp; empty disables MCP (all requests get 401)
# optional residential proxy for chalk sandboxes; when set, each sandbox browser egresses through it with a per-connection sticky session.
RESI_PROXY_HOST=
RESI_PROXY_PORT=
RESI_PROXY_USER=
RESI_PROXY_PASS=
